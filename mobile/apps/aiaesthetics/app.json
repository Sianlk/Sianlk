{
  "expo": {
    "name": "AI Aesthetics",
    "slug": "aiaesthetics",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0A1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sianlk.aiaesthetics",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "AI Aesthetics uses camera for AI-powered features",
        "NSMicrophoneUsageDescription": "AI Aesthetics uses microphone for voice AI input",
        "NSPhotoLibraryUsageDescription": "AI Aesthetics accesses photos for AI analysis features",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0A1A"
      },
      "package": "com.sianlk.aiaesthetics",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-linear-gradient",
      "expo-blur"
    ],
    "extra": {
      "apiBase": "https://sianlk-unified-9w6jz.ondigitalocean.app",
      "appSlug": "aiaesthetics",
      "proPriceGbp": 7.99,
      "privacyPolicy": "https://sianlk.com/privacy",
      "termsOfService": "https://sianlk.com/terms",
      "eas": {
        "projectId": "ecc51b25-983b-4f92-9571-34f365f8a3ef"
      }
    },
    "owner": "sianlk",
    "updates": {
      "url": "https://u.expo.dev/ecc51b25-983b-4f92-9571-34f365f8a3ef",
      "enabled": true
    }
  }
}
