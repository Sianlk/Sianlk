{
  "expo": {
    "name": "AI Business",
    "slug": "aib",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sianlk.aib",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "AI Business uses camera for AI-powered features",
        "NSMicrophoneUsageDescription": "AI Business uses microphone for voice AI input",
        "NSPhotoLibraryUsageDescription": "AI Business accesses photos for AI analysis features",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.sianlk.aib",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-linear-gradient",
      "expo-blur"
    ],
    "extra": {
      "apiBase": "https://sianlk-unified-9w6jz.ondigitalocean.app",
      "appSlug": "aib",
      "proPriceGbp": 14.99,
      "privacyPolicy": "https://sianlk.com/privacy",
      "termsOfService": "https://sianlk.com/terms",
      "eas": {
        "projectId": "sianlk-aib-v1"
      }
    },
    "owner": "sianlk"
  }
}