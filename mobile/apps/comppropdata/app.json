{
  "expo": {
    "name": "CompPropData",
    "slug": "comppropdata",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#001A1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sianlk.comppropdata",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "CompPropData uses camera for AI-powered features",
        "NSMicrophoneUsageDescription": "CompPropData uses microphone for voice AI input",
        "NSPhotoLibraryUsageDescription": "CompPropData accesses photos for AI analysis features",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001A1A"
      },
      "package": "com.sianlk.comppropdata",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-linear-gradient",
      "expo-blur"
    ],
    "extra": {
      "apiBase": "https://sianlk-unified-9w6jz.ondigitalocean.app",
      "appSlug": "comppropdata",
      "proPriceGbp": 24.99,
      "privacyPolicy": "https://sianlk.com/privacy",
      "termsOfService": "https://sianlk.com/terms",
      "eas": {
        "projectId": "sianlk-comppropdata-v1"
      }
    },
    "owner": "sianlk"
  }
}