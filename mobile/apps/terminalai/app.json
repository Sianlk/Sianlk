{
  "expo": {
    "name": "TerminalAI",
    "slug": "terminalai",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#001A00"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sianlk.terminalai",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "TerminalAI uses camera for AI-powered features",
        "NSMicrophoneUsageDescription": "TerminalAI uses microphone for voice AI input",
        "NSPhotoLibraryUsageDescription": "TerminalAI accesses photos for AI analysis features",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001A00"
      },
      "package": "com.sianlk.terminalai",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-linear-gradient",
      "expo-blur"
    ],
    "extra": {
      "apiBase": "https://sianlk-unified-9w6jz.ondigitalocean.app",
      "appSlug": "terminalai",
      "proPriceGbp": 9.99,
      "privacyPolicy": "https://sianlk.com/privacy",
      "termsOfService": "https://sianlk.com/terms",
      "eas": {
        "projectId": "549cc999-7dff-42a3-a61d-2483965f9ef7"
      }
    },
    "owner": "sianlk",
    "updates": {
      "url": "https://u.expo.dev/549cc999-7dff-42a3-a61d-2483965f9ef7",
      "enabled": true
    }
  }
}
